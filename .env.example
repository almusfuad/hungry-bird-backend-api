# ============================================================
# Django Core Settings
# ============================================================
# Set to False in production
DEBUG=True

# Generate a strong secret key in production
# You can generate one using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-change-this-in-production-min-50-chars

# Space or comma separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,localhost:5173,127.0.0.1:5173

# Timezone setting (use standard timezone names)
TIME_ZONE=UTC

# ============================================================
# Database Configuration
# ============================================================
# DEVELOPMENT: SQLite (default)
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# PRODUCTION: AWS RDS PostgreSQL (uncomment and configure)
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=hungry_bird_db
# DATABASE_USER=postgres
# DATABASE_PASSWORD=your_rds_password_here
# DATABASE_HOST=your-rds-endpoint.rds.amazonaws.com
# DATABASE_PORT=5432

# ============================================================
# Redis & Channel Layer Settings
# ============================================================
# Redis host for caching and WebSocket support
REDIS_HOST=127.0.0.1

# Redis port
REDIS_PORT=6379

# Redis password (leave empty if no password is set)
REDIS_PASSWORD=

# ============================================================
# Celery Configuration
# ============================================================
# Celery broker URL (Redis)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Celery result backend URL (Redis)
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Run Celery tasks synchronously in development for easier debugging
# Set to False in production for async execution
CELERY_TASK_ALWAYS_EAGER=True

# ============================================================
# JWT Token Settings (in minutes)
# ============================================================
# Access token lifetime (default: 60 minutes)
ACCESS_TOKEN_LIFETIME=60

# Refresh token lifetime (default: 1440 minutes = 24 hours)
REFRESH_TOKEN_LIFETIME=1440

# ============================================================
# Payment Gateway (Stripe)
# ============================================================
# Stripe test keys (replace with production keys in production)
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here
STRIPE_SECRET_KEY=sk_test_your_test_key_here

# ============================================================
# AWS S3 Storage Configuration
# ============================================================
# DEVELOPMENT: Leave commented out to use local filesystem
# PRODUCTION: Uncomment and configure for S3 storage

# AWS access key
# AWS_ACCESS_KEY_ID=your_aws_access_key_id

# AWS secret access key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# S3 bucket name
# AWS_STORAGE_BUCKET_NAME=your-bucket-name

# AWS region (default: us-east-1)
# AWS_S3_REGION_NAME=us-east-1

# Custom domain for S3 bucket (e.g., your-bucket-name.s3.amazonaws.com)
# AWS_S3_CUSTOM_DOMAIN=your-bucket-name.s3.amazonaws.com

# S3 endpoint URL (optional, for custom S3-compatible services)
# AWS_S3_ENDPOINT_URL=https://your-bucket-name.s3.amazonaws.com

# ============================================================
# CORS Settings
# ============================================================
# Comma-separated list of allowed origins for CORS
# DEVELOPMENT: Allow localhost with frontend port
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PRODUCTION: Add your production domain(s)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================
# Swagger/API Documentation Settings
# ============================================================
# Enable/disable Swagger UI
SWAGGER_ENABLED=True

# Swagger UI theme
SWAGGER_UI_THEME=swagger-ui

# ============================================================
# Additional Environment Configuration Examples
# ============================================================
# For production AWS RDS setup, use:
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=hungry_bird_db
# DATABASE_USER=admin
# DATABASE_PASSWORD=YourSecurePassword123!
# DATABASE_HOST=hungry-bird-db.c9akciq32.us-east-1.rds.amazonaws.com
# DATABASE_PORT=5432

# For production S3 setup, use:
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_STORAGE_BUCKET_NAME=hungry-bird-production
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=cdn.yourdomain.com
# AWS_S3_ENDPOINT_URL=https://cdn.yourdomain.com
